#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/zhuoersheng/Projects/Webpage_Practices/practice4/node_modules/.pnpm/webpack-cli@4.10.0_webpack@5.108.4/node_modules/webpack-cli/node_modules:/Users/zhuoersheng/Projects/Webpage_Practices/practice4/node_modules/.pnpm/webpack-cli@4.10.0_webpack@5.108.4/node_modules:/Users/zhuoersheng/Projects/Webpage_Practices/practice4/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/zhuoersheng/Projects/Webpage_Practices/practice4/node_modules/.pnpm/webpack-cli@4.10.0_webpack@5.108.4/node_modules/webpack-cli/node_modules:/Users/zhuoersheng/Projects/Webpage_Practices/practice4/node_modules/.pnpm/webpack-cli@4.10.0_webpack@5.108.4/node_modules:/Users/zhuoersheng/Projects/Webpage_Practices/practice4/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/cli.js" "$@"
else
  exec node  "$basedir/../../bin/cli.js" "$@"
fi
